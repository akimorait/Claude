# ── Connection ────────────────────────────────────────────────────────────────
# WebSocket strongly recommended (push-based block events). https:// also works
# (the bot falls back to polling).
RPC_URL=wss://mainnet.example.com/ws/v3/YOUR_KEY
CHAIN_ID=1

# ── Keys (SECURITY: read carefully) ───────────────────────────────────────────
# Executor HOT key. Fund it with gas ETH only (0.1–0.5 ETH). It can trigger
# arbitrage but can NEVER withdraw funds — withdrawals are owner-only, and the
# owner key should live in cold storage, not on this machine, never in this file.
PRIVATE_KEY=

# Deployed FlashArbitrage contract address.
CONTRACT_ADDRESS=

# ── Behaviour ─────────────────────────────────────────────────────────────────
# SAFE DEFAULT: dry run logs every opportunity but sends nothing.
# Flip to false only after you've watched the logs and are happy.
DRY_RUN=true

# flash  = flash-swap mode, zero capital required (recommended)
# funded = uses WETH held by the contract, ~30k gas cheaper per trade
MODE=flash

# ── Economics ─────────────────────────────────────────────────────────────────
# Minimum profit AFTER gas and bribe, per trade. Below this, don't bother.
MIN_NET_PROFIT_ETH=0.005

# Share of gross profit paid to the block builder (in basis points, 5000 = 50%).
# Competitive searchers routinely bid away most of the profit; raising this
# improves inclusion odds, lowering it improves margin. 0 disables.
BRIBE_BPS=5000

PRIORITY_FEE_GWEI=2
GAS_UNITS_ESTIMATE=220000
GAS_LIMIT=350000

# Blocks the tx stays valid for (on-chain deadline + Flashbots maxBlockNumber).
DEADLINE_BLOCKS=2

# eth_call preflight of the exact calldata before sending (recommended).
SIMULATE=true

# ── Submission ────────────────────────────────────────────────────────────────
# flashbots = private submission, never enters the public mempool (recommended:
#             no front-running of your tx, reverted txs cost nothing)
# public    = ordinary broadcast (reverts burn gas; copiers see your calldata)
SUBMIT=flashbots
FLASHBOTS_RELAY=https://relay.flashbots.net
# Optional separate identity key for Flashbots reputation (any funded-or-not
# key). Defaults to PRIVATE_KEY.
FLASHBOTS_SIGNER_KEY=

# ── Watchlist ─────────────────────────────────────────────────────────────────
# cp tokens.example.json tokens.json  (then edit)
TOKENS_FILE=tokens.json

# error | warn | info | debug   (debug prints per-token per-block evaluations)
LOG_LEVEL=info

# ── Overrides for testnets / other V2 forks (mainnet defaults built in) ──────
# WETH_ADDRESS=
# FACTORY_A=
# INIT_CODE_HASH_A=
# FACTORY_B=
# INIT_CODE_HASH_B=
# MULTICALL3_ADDRESS=
# POLL_INTERVAL_MS=1000
