<div></div>
{% schema %}
{
  "name": "Newsletter popup",
  "class": "pp-popup-section",
  "settings": [
    {
      "type": "header",
      "content": "Turn on and A/B test"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show the popup",
      "default": true
    },
    {
      "type": "text",
      "id": "experiment",
      "label": "Test name",
      "default": "popup-test-1",
      "info": "Change this name to start a brand-new test. Every visitor is shuffled into a design again."
    },
    {
      "type": "range",
      "id": "weight_a",
      "label": "Design A · Pocket Pop (share of visitors)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "weight_b",
      "label": "Design B · Lights On (share of visitors)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "weight_c",
      "label": "Design C · Colour Pick (share of visitors)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "weight_d",
      "label": "Design D · Room Match (share of visitors)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "weight_e",
      "label": "Design E · Print Job (share of visitors)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 20
    },
    {
      "type": "paragraph",
      "content": "Set a design to 0 to switch it off. When you have a winner, set the others to 0. While editing here, the design with the biggest share is shown."
    },
    {
      "type": "header",
      "content": "When it appears"
    },
    {
      "type": "range",
      "id": "delay",
      "label": "After this many seconds (0 = off)",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 8
    },
    {
      "type": "range",
      "id": "scroll",
      "label": "Or after scrolling this far (0 = off)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "exit_intent",
      "label": "Or when the mouse heads for the browser tabs (computers only)",
      "default": true
    },
    {
      "type": "range",
      "id": "mobile_delay",
      "label": "On phones, after this many seconds (0 = off)",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 12,
      "info": "A little longer than on computers, so phone visitors from Google see the page first."
    },
    {
      "type": "checkbox",
      "id": "mobile_exit",
      "label": "On phones, when someone flicks quickly back up the page (like they're about to leave)",
      "default": true
    },
    {
      "type": "range",
      "id": "hide_days",
      "label": "After someone closes it, hide it for",
      "min": 1,
      "max": 60,
      "step": 1,
      "unit": "d",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "tab",
      "label": "After closing, keep a small tab in the corner to reopen it",
      "default": true,
      "info": "Visitors can hide the tab with its own x."
    },
    {
      "type": "header",
      "content": "Words"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the headline",
      "default": "✹ the pocket list"
    },
    {
      "type": "text",
      "id": "headline_a",
      "label": "Headline for A",
      "default": "Get first dibs on new lamps."
    },
    {
      "type": "text",
      "id": "headline_b",
      "label": "Headline for B",
      "default": "Be first to the glow."
    },
    {
      "type": "text",
      "id": "headline_c",
      "label": "Colour question for C",
      "default": "What's your colour?"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Description",
      "default": "Our monthly newsletter: new designs, fresh colours and early-bird specials, straight from the Melbourne studio."
    },
    {
      "type": "text",
      "id": "offer",
      "label": "Offer line (leave empty for none)",
      "default": "$10 off your first order over $100"
    }
  ],
  "presets": [
    {
      "name": "Newsletter popup"
    }
  ]
}
{% endschema %}
