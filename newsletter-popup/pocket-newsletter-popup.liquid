{%- comment -%}
  Pocket newsletter popup with A/B/C testing.
  Built from newsletter-popup/src by build.py. Edit the src files, not this one.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign suppress = false
  if customer and customer.accepts_marketing
    assign suppress = true
  endif
  if template.name == 'cart' or template.name == 'password' or template.directory == 'customers'
    assign suppress = true
  endif

  assign image_b = s.image_b
  if image_b == blank
    assign image_b = all_products['limoncello-lamp'].featured_image
  endif

  if routes.root_url == '/'
    assign contact_url = '/contact'
  else
    assign contact_url = routes.root_url | append: '/contact'
  endif
-%}
{%- if s.enabled -%}
  <script type="application/json" id="pp-popup-config">
    {
      "enabled": true,
      "experiment": {{ s.experiment | default: 'popup-test-1' | handleize | json }},
      "weights": { "A": {{ s.weight_a | json }}, "B": {{ s.weight_b | json }}, "C": {{ s.weight_c | json }} },
      "editorVariant": {{ s.editor_variant | json }},
      "designMode": {{ request.design_mode | json }},
      "suppress": {{ suppress | json }},
      "delay": {{ s.delay | json }},
      "scroll": {{ s.scroll | json }},
      "exitIntent": {{ s.exit_intent | json }},
      "hideDays": {{ s.hide_days | json }},
      "tab": {{ s.tab | json }},
      "tabLabel": {{ s.tab_label | json }},
      "eyebrow": {{ s.eyebrow | json }},
      "marquee": {{ s.marquee | json }},
      "headlineA": {{ s.headline_a | json }},
      "headlineB": {{ s.headline_b | json }},
      "headlineC": {{ s.headline_c | json }},
      "headlineC2": {{ s.headline_c2 | json }},
      "body": {{ s.body | json }},
      "offer": {{ s.offer | json }},
      "button": {{ s.button | json }},
      "fine": {{ s.fine | json }},
      "successTitle": {{ s.success_title | json }},
      "successBody": {{ s.success_body | json }},
      "code": {{ s.discount_code | strip | json }},
      "extraTags": {{ s.extra_tags | json }},
      "shopLabel": {{ s.shop_label | json }},
      "shopUrl": {{ s.shop_link | default: routes.all_products_collection_url | json }},
      "imageB": {% if image_b != blank %}{{ image_b | image_url: width: 900 | json }}{% else %}""{% endif %},
      "contactUrl": {{ contact_url | json }}
    }
  </script>

  <div hidden>
    {%- form 'customer', id: 'pp-popup-native' -%}
      <input type="hidden" name="contact[email]" value="">
      <input type="hidden" name="contact[tags]" value="newsletter">
    {%- endform -%}
  </div>

  <style>{% raw %}/* Pocket Picked It newsletter popup. Everything is scoped under .ppp so it
   can't leak into the theme. Colours and fonts mirror the live store:
   Poppins headings, the theme's mono body face, orange halo buttons, cream. */
.ppp {
  --pp-ink: #1d1c1c;
  --pp-paper: #ffffff;
  --pp-cream: #ffefd9;
  --pp-orange: #fbb658;
  --pp-orange-deep: #f6a43a;
  --pp-halo: rgba(251, 182, 88, 0.42);
  --pp-label: #fdfbf7;
  --pp-coral: #e5483f;
  --pp-muted: rgba(29, 28, 28, 0.66);
  --pp-line: rgba(29, 28, 28, 0.2);
  --pp-dot1: #d77103;
  --pp-dot2: #fbb657;
  --pp-dot3: #697b2f;
  --pp-dot4: #577e85;
  --pp-head: var(--font-heading-family, Poppins, ui-sans-serif, system-ui, sans-serif);
  --pp-mono: var(--font-body-family, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace);
  --pp-ease: cubic-bezier(0.2, 0.9, 0.25, 1.12);

  position: fixed;
  inset: 0;
  z-index: 2147483000;
  pointer-events: none;
  font-family: var(--pp-mono);
  color: var(--pp-ink);
  text-align: left;
  -webkit-font-smoothing: antialiased;
}
.ppp *, .ppp *::before, .ppp *::after { box-sizing: border-box; }
.ppp [hidden] { display: none !important; }
html.ppp-lock, html.ppp-lock body { overflow: hidden; }

.ppp__sr {
  position: absolute; width: 1px; height: 1px; overflow: hidden;
  clip: rect(0 0 0 0); white-space: nowrap;
}

/* ---------- shell ---------- */
.ppp--a, .ppp--b {
  display: grid;
  place-items: center;
  padding: 24px;
}
.ppp__scrim {
  position: absolute;
  inset: 0;
  background: rgba(29, 28, 28, 0.45);
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: auto;
}
.ppp.is-open .ppp__scrim { opacity: 1; }

.ppp__card {
  position: relative;
  pointer-events: auto;
  background: var(--pp-paper);
  color: var(--pp-ink);
  border-radius: 28px;
  box-shadow: 0 30px 80px -24px rgba(29, 28, 28, 0.5), 0 0 0 1px rgba(29, 28, 28, 0.05);
  opacity: 0;
  transform: translateY(18px) scale(0.97);
  transition: opacity 0.28s ease, transform 0.5s var(--pp-ease);
  outline: none;
  max-height: calc(100% - 8px);
  overflow: auto;
  overscroll-behavior: contain;
}
.ppp.is-open .ppp__card { opacity: 1; transform: none; }
.ppp.is-closing .ppp__card { transition-duration: 0.2s; transform: translateY(10px) scale(0.98); }

.ppp__x {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 3;
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 50%;
  background: rgba(29, 28, 28, 0.07);
  color: var(--pp-ink);
  cursor: pointer;
  transition: background 0.15s ease, transform 0.15s ease;
}
.ppp__x:hover { background: rgba(29, 28, 28, 0.13); transform: rotate(90deg); }
.ppp__x svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; }

/* ---------- type ---------- */
.ppp__main, .ppp__done { display: flex; flex-direction: column; gap: 14px; }
.ppp__eyebrow {
  margin: 0;
  font: 700 11px/1.3 var(--pp-mono);
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
.ppp__title {
  margin: 0;
  font-family: var(--pp-head);
  font-weight: 700;
  font-size: 34px;
  line-height: 1.06;
  letter-spacing: -0.02em;
  text-wrap: balance;
  outline: none;
}
.ppp__body {
  margin: 0;
  font: 400 14px/1.6 var(--pp-mono);
  color: var(--pp-muted);
  text-wrap: pretty;
}
.ppp__offer {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin: 0;
  padding: 7px 14px;
  border-radius: 16px;
  background: var(--pp-cream);
  font: 700 13px/1.3 var(--pp-mono);
}
.ppp__offer span { color: var(--pp-dot1); }

/* ---------- form ---------- */
.ppp__form { display: flex; flex-direction: column; gap: 14px; margin-top: 4px; }
.ppp__input {
  width: 100%;
  height: 52px;
  padding: 0 22px;
  border: 1.5px solid var(--pp-line);
  border-radius: 999px;
  background: #fff;
  color: var(--pp-ink);
  font: 400 15px var(--pp-mono);
  outline: none;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
  -webkit-appearance: none;
  appearance: none;
}
.ppp__input::placeholder { color: rgba(29, 28, 28, 0.42); }
.ppp__input:focus { border-color: var(--pp-ink); box-shadow: 0 0 0 4px var(--pp-halo); }
.ppp__input[aria-invalid="true"] { border-color: var(--pp-coral); }

.ppp__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: calc(100% - 12px);
  height: 50px;
  margin: 6px;
  padding: 0 24px;
  border: 0;
  border-radius: 999px;
  background: var(--pp-orange);
  color: var(--pp-label);
  box-shadow: 0 0 0 6px var(--pp-halo);
  font: 700 16px var(--pp-mono);
  letter-spacing: 0.02em;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.15s ease, box-shadow 0.2s ease, transform 0.1s ease;
}
.ppp__btn:hover { background: var(--pp-orange-deep); box-shadow: 0 0 0 8px var(--pp-halo); }
.ppp__btn:active { transform: translateY(1px); }
.ppp__btn:focus-visible { outline: 2px solid var(--pp-ink); outline-offset: 9px; }
.ppp__btn:disabled { cursor: progress; opacity: 0.8; }
.ppp__err { margin: 0; color: var(--pp-coral); font: 700 12.5px/1.5 var(--pp-mono); }
.ppp__fine { margin: 0; color: var(--pp-muted); font: 400 11.5px/1.5 var(--pp-mono); }

/* ---------- success ---------- */
.ppp__done { align-items: flex-start; }
.ppp__done-dots, .ppp-a__dots { display: flex; gap: 8px; }
.ppp__done-dots i, .ppp-a__dots i {
  width: 16px; height: 16px; border-radius: 50%; display: block;
}
.ppp__done-dots i:nth-child(1), .ppp-a__dots i:nth-child(1) { background: var(--pp-dot1); }
.ppp__done-dots i:nth-child(2), .ppp-a__dots i:nth-child(2) { background: var(--pp-dot2); }
.ppp__done-dots i:nth-child(3), .ppp-a__dots i:nth-child(3) { background: var(--pp-dot3); }
.ppp__done-dots i:nth-child(4), .ppp-a__dots i:nth-child(4) { background: var(--pp-dot4); }
.ppp.is-open .ppp-a__dots i, .ppp__done:not([hidden]) .ppp__done-dots i { animation: ppp-pop 0.55s var(--pp-ease) both; }
.ppp-a__dots i:nth-child(2), .ppp__done-dots i:nth-child(2) { animation-delay: 0.08s !important; }
.ppp-a__dots i:nth-child(3), .ppp__done-dots i:nth-child(3) { animation-delay: 0.16s !important; }
.ppp-a__dots i:nth-child(4), .ppp__done-dots i:nth-child(4) { animation-delay: 0.24s !important; }
@keyframes ppp-pop { from { transform: scale(0); } to { transform: scale(1); } }

.ppp__code { display: flex; flex-direction: column; gap: 6px; width: 100%; }
.ppp__code-label { font: 700 11px var(--pp-mono); letter-spacing: 0.14em; text-transform: uppercase; }
.ppp__code-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
  padding: 14px 18px;
  border: 1.5px dashed var(--pp-ink);
  border-radius: 14px;
  background: var(--pp-cream);
  color: var(--pp-ink);
  cursor: pointer;
  font-family: var(--pp-mono);
}
.ppp__code-btn b { font-size: 18px; letter-spacing: 0.08em; user-select: all; }
.ppp__code-btn small { font-size: 12px; text-decoration: underline; }
.ppp__btn--link { margin-top: 8px; }

/* ---------- A · Pocket Pop ---------- */
.ppp-a { width: min(460px, 100%); }
.ppp-a__band {
  height: 42px;
  overflow: hidden;
  background: var(--pp-cream);
  display: flex;
  align-items: center;
  border-radius: 28px 28px 0 0;
}
.ppp-a__track {
  display: flex;
  flex: none;
  white-space: nowrap;
  font: 700 15px var(--pp-mono);
  animation: ppp-marquee 22s linear infinite;
}
@keyframes ppp-marquee { to { transform: translateX(-50%); } }
.ppp-a .ppp__x { top: 56px; }
.ppp-a .ppp__inner { padding: 30px 40px 34px; }
.ppp-a .ppp__main, .ppp-a .ppp__done { align-items: center; text-align: center; }
.ppp-a .ppp__offer { align-self: center; }
.ppp-a .ppp__form { width: 100%; }
.ppp-a .ppp__body { max-width: 34ch; }
.ppp-a__dots { margin-bottom: 4px; }

/* ---------- B · Lights On ---------- */
.ppp-b {
  width: min(840px, 100%);
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 500px;
  overflow: hidden;
}
.ppp-b__media { position: relative; overflow: hidden; background: #2a2724; min-height: 220px; }
.ppp-b__media img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  max-width: none;
  object-fit: cover;
  filter: brightness(0.3) saturate(0.45);
}
.ppp-b__glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(60% 50% at 50% 42%, rgba(255, 196, 92, 0.38), transparent 70%);
  mix-blend-mode: screen;
  opacity: 0;
}
.ppp-b.ppp-b--noimg .ppp-b__media { background: var(--pp-cream); display: grid; place-items: center; }
.ppp-b__bigdots { display: grid; grid-template-columns: repeat(2, 64px); gap: 14px; }
.ppp-b__bigdots i { width: 64px; height: 64px; border-radius: 50%; display: block; }
.ppp-b__bigdots i:nth-child(1) { background: var(--pp-dot1); }
.ppp-b__bigdots i:nth-child(2) { background: var(--pp-dot2); }
.ppp-b__bigdots i:nth-child(3) { background: var(--pp-dot3); }
.ppp-b__bigdots i:nth-child(4) { background: var(--pp-dot4); }
.ppp-b__tag {
  position: absolute;
  left: 18px;
  bottom: 18px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.92);
  font: 700 11px var(--pp-mono);
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.ppp-b__tag i { width: 9px; height: 9px; border-radius: 50%; background: #9a958e; transition: background 0.2s, box-shadow 0.2s; }
.ppp-b__on { display: none; }
.ppp.is-lit .ppp-b__on { display: inline; }
.ppp.is-lit .ppp-b__off { display: none; }
.ppp.is-lit .ppp-b__tag i { background: var(--pp-orange); box-shadow: 0 0 0 4px var(--pp-halo); }
.ppp.is-lit .ppp-b__media img { animation: ppp-flicker 1.1s linear forwards; }
.ppp.is-lit .ppp-b__glow { animation: ppp-glow 1.1s linear forwards; }
@keyframes ppp-flicker {
  0% { filter: brightness(0.3) saturate(0.45); }
  8% { filter: brightness(1.05) saturate(1); }
  14% { filter: brightness(0.38) saturate(0.5); }
  26% { filter: brightness(1) saturate(1); }
  32% { filter: brightness(0.62) saturate(0.8); }
  44%, 100% { filter: brightness(1) saturate(1); }
}
@keyframes ppp-glow { 0%, 40% { opacity: 0; } 100% { opacity: 1; } }

.ppp-b__panel {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 48px 44px 40px;
  background: var(--pp-cream);
}
.ppp-b .ppp__offer { background: var(--pp-paper); }
.ppp-b .ppp__x { background: rgba(255, 255, 255, 0.7); }
.ppp-b .ppp__title { font-size: 36px; }

/* ---------- C · Colour Pick ---------- */
.ppp-c {
  position: absolute;
  right: 24px;
  bottom: 24px;
  width: 372px;
  max-width: calc(100% - 32px);
  padding: 26px 24px 24px;
  border-radius: 26px;
  transform: translateY(28px);
  box-shadow: 0 24px 60px -20px rgba(29, 28, 28, 0.45), 0 0 0 1.5px var(--pp-ink);
}
.ppp-c .ppp__x { top: 12px; right: 12px; width: 32px; height: 32px; }
.ppp-c .ppp__title { font-size: 26px; padding-right: 30px; }
.ppp-c__step { display: flex; flex-direction: column; gap: 14px; }
.ppp-c__swatches {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px 6px;
  margin-top: 4px;
}
.ppp-c__sw {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7px;
  padding: 4px 0;
  border: 0;
  background: none;
  color: var(--pp-ink);
  cursor: pointer;
  font: 400 11px var(--pp-mono);
}
.ppp-c__sw i {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  display: block;
  background: var(--sw);
  box-shadow: inset 0 0 0 1px rgba(29, 28, 28, 0.12);
  transition: transform 0.2s var(--pp-ease), box-shadow 0.2s ease;
}
.ppp-c__sw--all i {
  background: conic-gradient(#f5d04c, #f2a6b8, #f08a2c, #5e3b2a, #e6d8bf, #9ed3b8, #b9773f, #f5d04c);
}
.ppp-c__sw:hover i { transform: scale(1.1); }
.ppp-c__sw:focus-visible { outline: none; }
.ppp-c__sw:focus-visible i { box-shadow: 0 0 0 3px #fff, 0 0 0 5px var(--pp-ink); }
.ppp.is-open .ppp-c__sw i { animation: ppp-pop 0.5s var(--pp-ease) both; }
.ppp-c__sw:nth-child(2) i { animation-delay: 0.04s !important; }
.ppp-c__sw:nth-child(3) i { animation-delay: 0.08s !important; }
.ppp-c__sw:nth-child(4) i { animation-delay: 0.12s !important; }
.ppp-c__sw:nth-child(5) i { animation-delay: 0.16s !important; }
.ppp-c__sw:nth-child(6) i { animation-delay: 0.2s !important; }
.ppp-c__sw:nth-child(7) i { animation-delay: 0.24s !important; }
.ppp-c__sw:nth-child(8) i { animation-delay: 0.28s !important; }

.ppp-c__chosen {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px 6px 6px;
  border: 1.5px solid var(--pp-line);
  border-radius: 999px;
  background: #fff;
  color: var(--pp-ink);
  cursor: pointer;
  font: 700 12px var(--pp-mono);
}
.ppp-c__chosen i { width: 22px; height: 22px; border-radius: 50%; background: var(--pick); box-shadow: inset 0 0 0 1px rgba(29, 28, 28, 0.12); }
.ppp-c--all .ppp-c__chosen i { background: conic-gradient(#f5d04c, #f2a6b8, #f08a2c, #5e3b2a, #e6d8bf, #9ed3b8, #b9773f, #f5d04c); }
.ppp-c__chosen small { font-weight: 400; text-decoration: underline; color: var(--pp-muted); }
.ppp-c .ppp__body { font-size: 13px; }
.ppp-c .ppp__done .ppp__title { font-size: 26px; }

/* ---------- minimised tab ---------- */
.ppp-tab {
  position: absolute;
  left: max(20px, env(safe-area-inset-left, 0px));
  bottom: calc(20px + env(safe-area-inset-bottom, 0px));
  display: flex;
  align-items: center;
  pointer-events: auto;
  background: var(--pp-paper);
  border-radius: 999px;
  box-shadow: 0 12px 30px -12px rgba(29, 28, 28, 0.45), 0 0 0 1.5px var(--pp-ink);
  opacity: 0;
  transform: translateX(-24px);
  transition: opacity 0.25s ease, transform 0.45s var(--pp-ease);
}
.ppp--tab.is-open .ppp-tab { opacity: 1; transform: none; }
.ppp-tab__open {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 6px 10px 12px;
  border: 0;
  background: none;
  color: var(--pp-ink);
  cursor: pointer;
  font: 700 13px var(--pp-mono);
}
.ppp-tab__dots { display: grid; grid-template-columns: repeat(2, 8px); gap: 3px; }
.ppp-tab__dots i { width: 8px; height: 8px; border-radius: 50%; display: block; }
.ppp-tab__dots i:nth-child(1) { background: var(--pp-dot1); }
.ppp-tab__dots i:nth-child(2) { background: var(--pp-dot2); }
.ppp-tab__dots i:nth-child(3) { background: var(--pp-dot3); }
.ppp-tab__dots i:nth-child(4) { background: var(--pp-dot4); }
.ppp-tab__open:hover span { text-decoration: underline; }
.ppp-tab__x {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  margin-right: 6px;
  border: 0;
  border-radius: 50%;
  background: rgba(29, 28, 28, 0.07);
  color: var(--pp-ink);
  cursor: pointer;
}
.ppp-tab__x svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; }
.ppp-tab button:focus-visible { outline: 2px solid var(--pp-ink); outline-offset: 2px; border-radius: 999px; }

/* ---------- small screens (class set by script from the real width) ---------- */
.ppp--compact.ppp--a, .ppp--compact.ppp--b { padding: 16px; }
.ppp--compact .ppp__title { font-size: 28px; }
.ppp--compact .ppp-a .ppp__inner { padding: 24px 22px 26px; }
.ppp--compact .ppp-b { grid-template-columns: 1fr; min-height: 0; }
.ppp--compact .ppp-b__media { min-height: 0; height: 190px; }
.ppp--compact .ppp-b__panel { padding: 26px 22px 26px; }
.ppp--compact .ppp-b .ppp__title { font-size: 28px; }
.ppp--compact .ppp-b .ppp__x { background: rgba(255, 255, 255, 0.9); }
.ppp--compact .ppp-c {
  left: 0;
  right: 0;
  bottom: 0;
  width: auto;
  max-width: none;
  border-radius: 24px 24px 0 0;
  padding: 26px max(20px, env(safe-area-inset-right, 0px)) calc(22px + env(safe-area-inset-bottom, 0px)) max(20px, env(safe-area-inset-left, 0px));
  box-shadow: 0 -18px 50px -18px rgba(29, 28, 28, 0.45), 0 0 0 1.5px var(--pp-ink);
}
.ppp--compact .ppp-c::before {
  content: "";
  position: absolute;
  top: 9px;
  left: 50%;
  width: 40px;
  height: 4px;
  margin-left: -20px;
  border-radius: 4px;
  background: var(--pp-line);
}

@media (prefers-reduced-motion: reduce) {
  .ppp__card, .ppp__scrim, .ppp-tab { transition: opacity 0.15s linear; transform: none !important; }
  .ppp-a__track { animation: none; }
  .ppp *, .ppp *::before { animation-duration: 0.001s !important; animation-delay: 0s !important; }
}
{% endraw %}</style>
  <script>{% raw %}/*
 * Pocket Picked It newsletter popup, with a built-in A/B/C test.
 *
 * Settings arrive as JSON in #pp-popup-config (written by the Shopify section,
 * or by the preview page). Three designs share one form and one success state:
 *   A  Pocket Pop   centred card with the cream marquee band and logo dots
 *   B  Lights On    split card, lamp photo flickers on as it opens
 *   C  Colour Pick  corner card that asks for a favourite colour first
 *
 * Each visitor is given one design (weighted random), keeps it on every visit,
 * and every view / close / sign-up is reported with that design's letter.
 */
(() => {
  'use strict';

  const cfgEl = document.getElementById('pp-popup-config');
  if (!cfgEl) return;
  let C;
  try { C = JSON.parse(cfgEl.textContent); } catch (e) { return; }

  // The theme editor re-runs this script whenever a setting changes.
  if (window.PocketPopup && window.PocketPopup.destroy) window.PocketPopup.destroy();

  const VARIANTS = ['A', 'B', 'C'];
  const MODAL = { A: true, B: true, C: false };
  const COLOURS = C.colours || [
    { id: 'lemon', name: 'Lemon', hex: '#F5D04C' },
    { id: 'candy', name: 'Candy', hex: '#F2A6B8' },
    { id: 'mandarin', name: 'Mandarin', hex: '#F08A2C' },
    { id: 'chocolate', name: 'Chocolate', hex: '#5E3B2A' },
    { id: 'oatmeal', name: 'Oatmeal', hex: '#E6D8BF' },
    { id: 'spearmint', name: 'Spearmint', hex: '#9ED3B8' },
    { id: 'maple', name: 'Maple', hex: '#B9773F' },
  ];

  const experiment = String(C.experiment || 'popup-test-1');
  const K = {
    variant: 'pp_popup:' + experiment + ':variant',
    closedUntil: 'pp_popup:closed_until',
    joined: 'pp_popup:joined',
    pending: 'pp_popup:pending',
    tabOff: 'pp_popup:tab_off',
  };
  const store = {
    get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } },
    set(k, v) { try { localStorage.setItem(k, v); } catch (e) { /* storage blocked */ } },
    del(k) { try { localStorage.removeItem(k); } catch (e) { /* storage blocked */ } },
  };
  const persist = !C.preview && !C.designMode;
  const mount = (C.mount && document.querySelector(C.mount)) || document.body;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let root = null;
  let tab = null;
  let variant = null;
  let colour = null;
  let lastFocus = null;
  const cleanups = [];

  const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (ch) => (
    { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]
  ));

  /* ---------- A/B assignment ---------- */

  function weights() {
    const w = C.weights || {};
    return VARIANTS.map((id) => ({ id, w: Math.max(0, Number(w[id]) || 0) })).filter((x) => x.w > 0);
  }

  function forcedVariant() {
    const m = location.search.match(/[?&]pp_popup=([abc])\b/i);
    return m ? m[1].toUpperCase() : null;
  }

  // Weighted random pick, remembered per experiment so a visitor always sees
  // the same design. Renaming the experiment starts everyone afresh.
  function assign() {
    const pool = weights();
    if (!pool.length) return null;
    const saved = store.get(K.variant);
    if (saved && pool.some((x) => x.id === saved)) return saved;
    const total = pool.reduce((sum, x) => sum + x.w, 0);
    let r = Math.random() * total;
    let pick = pool[pool.length - 1].id;
    for (const x of pool) {
      r -= x.w;
      if (r < 0) { pick = x.id; break; }
    }
    if (persist) store.set(K.variant, pick);
    return pick;
  }

  /* ---------- reporting ---------- */

  function track(name, extra) {
    const params = Object.assign({ popup_variant: variant, popup_experiment: experiment }, extra || {});
    if (C.preview) {
      document.dispatchEvent(new CustomEvent('pp-popup-track', { detail: { name, params } }));
      return;
    }
    if (C.designMode) return;
    try { if (typeof window.gtag === 'function') window.gtag('event', name, params); } catch (e) { /* ignore */ }
    try {
      const a = window.Shopify && window.Shopify.analytics;
      if (a && typeof a.publish === 'function') a.publish(name, params);
    } catch (e) { /* ignore */ }
  }

  /* ---------- markup ---------- */

  const closeBtn = `<button type="button" class="ppp__x" data-close="button" aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>`;
  const dots = (cls) => `<div class="${cls}" aria-hidden="true"><i></i><i></i><i></i><i></i></div>`;
  const eyebrow = () => (C.eyebrow ? `<p class="ppp__eyebrow">${esc(C.eyebrow)}</p>` : '');
  const offer = () => (C.offer ? `<p class="ppp__offer"><span aria-hidden="true">✹</span>${esc(C.offer)}</p>` : '');

  function formHTML() {
    return `<form class="ppp__form" novalidate>
        <label class="ppp__sr" for="ppp-email">Email address</label>
        <input id="ppp-email" class="ppp__input" type="email" name="email" autocomplete="email"
          inputmode="email" placeholder="${esc(C.placeholder || 'your@email.com')}" required>
        <button class="ppp__btn" type="submit">${esc(C.button || 'Join the list')}</button>
        <p class="ppp__err" role="alert" hidden></p>
        ${C.fine ? `<p class="ppp__fine">${esc(C.fine)}</p>` : ''}
      </form>`;
  }

  function doneHTML() {
    const code = C.code
      ? `<div class="ppp__code">
          <span class="ppp__code-label">${esc(C.codeLabel || 'Your code for checkout')}</span>
          <button type="button" class="ppp__code-btn" data-copy="${esc(C.code)}">
            <b>${esc(C.code)}</b><small data-copy-label>Copy</small></button>
        </div>`
      : '';
    return `<div class="ppp__done" hidden>
        ${dots('ppp__done-dots')}
        <h2 class="ppp__title" tabindex="-1">${esc(C.successTitle || "You're on the list")}</h2>
        <p class="ppp__body">${esc(C.successBody || '')}</p>
        ${code}
        <a class="ppp__btn ppp__btn--link" href="${esc(C.shopUrl || '/collections/all')}">${esc(C.shopLabel || 'Shop lamps')}</a>
      </div>`;
  }

  const marqueeWords = () => (C.marquee || 'new designs ✹ fresh colours ✹ early-bird specials ✹ made in melbourne ✹')
    .trim();

  const TEMPLATES = {
    A: () => `
      <div class="ppp__scrim" data-close="scrim"></div>
      <div class="ppp__card ppp-a" role="dialog" aria-modal="true" aria-labelledby="ppp-title" tabindex="-1">
        <div class="ppp-a__band" aria-hidden="true"><div class="ppp-a__track">
          <span>${esc(marqueeWords())}&nbsp;</span><span>${esc(marqueeWords())}&nbsp;</span>
          <span>${esc(marqueeWords())}&nbsp;</span><span>${esc(marqueeWords())}&nbsp;</span>
        </div></div>
        ${closeBtn}
        <div class="ppp__inner">
          <div class="ppp__main">
            ${dots('ppp-a__dots')}
            ${eyebrow()}
            <h2 class="ppp__title" id="ppp-title">${esc(C.headlineA)}</h2>
            <p class="ppp__body">${esc(C.body)}</p>
            ${offer()}
            ${formHTML()}
          </div>
          ${doneHTML()}
        </div>
      </div>`,

    B: () => `
      <div class="ppp__scrim" data-close="scrim"></div>
      <div class="ppp__card ppp-b${C.imageB ? '' : ' ppp-b--noimg'}" role="dialog" aria-modal="true"
        aria-labelledby="ppp-title" tabindex="-1">
        ${closeBtn}
        <div class="ppp-b__media" aria-hidden="true">
          ${C.imageB ? `<img src="${esc(C.imageB)}" alt="" loading="eager" decoding="async">` : dots('ppp-b__bigdots')}
          <span class="ppp-b__glow"></span>
          <span class="ppp-b__tag"><i></i><span class="ppp-b__off">lights off</span><span class="ppp-b__on">lights on</span></span>
        </div>
        <div class="ppp-b__panel">
          <div class="ppp__main">
            ${eyebrow()}
            <h2 class="ppp__title" id="ppp-title">${esc(C.headlineB)}</h2>
            <p class="ppp__body">${esc(C.body)}</p>
            ${offer()}
            ${formHTML()}
          </div>
          ${doneHTML()}
        </div>
      </div>`,

    C: () => `
      <div class="ppp__card ppp-c" role="dialog" aria-modal="false" aria-labelledby="ppp-title" tabindex="-1">
        ${closeBtn}
        <div class="ppp__main">
          <div class="ppp-c__step" data-step="pick">
            ${eyebrow()}
            <h2 class="ppp__title" id="ppp-title">${esc(C.headlineC)}</h2>
            <div class="ppp-c__swatches" role="group" aria-label="Colours">
              ${COLOURS.map((c) => `<button type="button" class="ppp-c__sw" data-colour="${esc(c.id)}"
                data-name="${esc(c.name)}" style="--sw:${esc(c.hex)}"><i></i><span>${esc(c.name)}</span></button>`).join('')}
              <button type="button" class="ppp-c__sw ppp-c__sw--all" data-colour="all" data-name="All of them">
                <i></i><span>All of them</span></button>
            </div>
          </div>
          <div class="ppp-c__step" data-step="form" hidden>
            <button type="button" class="ppp-c__chosen" data-back>
              <i></i><span></span><small>change</small></button>
            <h2 class="ppp__title ppp-c__title2" tabindex="-1"></h2>
            <p class="ppp__body">${esc(C.body)}</p>
            ${offer()}
            ${formHTML()}
          </div>
        </div>
        ${doneHTML()}
      </div>`,
  };

  /* ---------- open / close ---------- */

  function viewportWidth() {
    return mount === document.body ? window.innerWidth : mount.clientWidth;
  }
  function fit() {
    if (root) root.classList.toggle('ppp--compact', viewportWidth() < 640);
  }

  function open(v, opts) {
    opts = opts || {};
    if (!TEMPLATES[v]) return;
    if (root) close(null);
    hideTab();
    variant = v;
    colour = null;
    lastFocus = document.activeElement;

    root = document.createElement('div');
    root.className = 'ppp ppp--' + v.toLowerCase() + (mount === document.body ? '' : ' ppp--contained');
    root.dataset.variant = v;
    root.innerHTML = TEMPLATES[v]();
    mount.appendChild(root);
    fit();
    wire(root);

    if (MODAL[v] && mount === document.body) document.documentElement.classList.add('ppp-lock');
    // Two frames so the starting styles paint before the transition runs.
    requestAnimationFrame(() => requestAnimationFrame(() => root && root.classList.add('is-open')));
    if (v === 'B') setTimeout(() => root && root.classList.add('is-lit'), reduceMotion ? 0 : 420);

    if (opts.success) showDone();
    else if (MODAL[v] && !C.preview) {
      const card = root.querySelector('.ppp__card');
      const input = root.querySelector('.ppp__input');
      const fine = window.matchMedia('(pointer: fine)').matches;
      (fine && input ? input : card).focus({ preventScroll: true });
    }
    if (!opts.silent) track('popup_view', { popup_trigger: opts.trigger || 'manual' });
  }

  function close(method) {
    if (!root) return;
    const el = root;
    root = null;
    el.classList.remove('is-open');
    el.classList.add('is-closing');
    setTimeout(() => el.remove(), reduceMotion ? 0 : 320);
    document.documentElement.classList.remove('ppp-lock');
    if (lastFocus && typeof lastFocus.focus === 'function' && document.contains(lastFocus)) {
      lastFocus.focus({ preventScroll: true });
    }
    if (!method) return;
    if (el.dataset.state !== 'done') {
      if (persist) store.set(K.closedUntil, String(Date.now() + (Number(C.hideDays) || 14) * 864e5));
      track('popup_close', { close_method: method });
      showTab(el.dataset.variant);
    }
    document.dispatchEvent(new CustomEvent('pp-popup-closed'));
  }

  /* ---------- minimised tab ---------- */

  // After a close, a small pill stays in the corner so visitors can reopen
  // the same design whenever they like, until they hide it or sign up.
  function showTab(v) {
    if (C.tab === false || !TEMPLATES[v]) return;
    hideTab();
    const label = C.tabLabel || (C.offer ? 'Get $10 off' : 'Join the list');
    tab = document.createElement('div');
    tab.className = 'ppp ppp--tab' + (mount === document.body ? '' : ' ppp--contained');
    tab.innerHTML = `<div class="ppp-tab">
        <button type="button" class="ppp-tab__open" data-tab="open">
          ${dots('ppp-tab__dots')}<span>${esc(label)}</span></button>
        <button type="button" class="ppp-tab__x" data-tab="hide" aria-label="Hide this">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      </div>`;
    tab.addEventListener('click', (e) => {
      const t = e.target.closest('[data-tab]');
      if (!t) return;
      if (t.dataset.tab === 'open') {
        open(v, { trigger: 'tab' });
      } else {
        hideTab();
        if (persist) store.set(K.tabOff, store.get(K.closedUntil) || String(Date.now() + 864e5));
        variant = v;
        track('popup_tab_hide');
        document.dispatchEvent(new CustomEvent('pp-popup-closed'));
      }
    });
    mount.appendChild(tab);
    requestAnimationFrame(() => requestAnimationFrame(() => tab && tab.classList.add('is-open')));
  }

  function hideTab() {
    if (tab) { tab.remove(); tab = null; }
  }

  function showDone() {
    if (!root) return;
    root.dataset.state = 'done';
    root.querySelectorAll('.ppp__main').forEach((n) => { n.hidden = true; });
    const done = root.querySelector('.ppp__done');
    done.hidden = false;
    const title = done.querySelector('.ppp__title');
    if (title) title.focus({ preventScroll: true });
  }

  /* ---------- behaviour ---------- */

  function wire(el) {
    el.addEventListener('click', (e) => {
      const t = e.target.closest('[data-close],[data-colour],[data-back],[data-copy]');
      if (!t) return;
      if (t.dataset.close) close(t.dataset.close);
      else if (t.dataset.colour) pickColour(t.dataset.colour, t.dataset.name, t.style.getPropertyValue('--sw'));
      else if (t.hasAttribute('data-back')) stepTo('pick');
      else if (t.dataset.copy) copyCode(t);
    });
    const form = el.querySelector('.ppp__form');
    if (form) form.addEventListener('submit', onSubmit);
  }

  function stepTo(step) {
    root.querySelectorAll('.ppp-c__step').forEach((s) => { s.hidden = s.dataset.step !== step; });
    const focusEl = step === 'form' ? root.querySelector('.ppp-c__title2') : root.querySelector('.ppp-c__sw');
    if (focusEl) focusEl.focus({ preventScroll: true });
  }

  function pickColour(id, name, hex) {
    colour = id;
    const card = root.querySelector('.ppp-c');
    const chip = root.querySelector('.ppp-c__chosen');
    card.style.setProperty('--pick', hex || 'transparent');
    card.classList.toggle('ppp-c--all', id === 'all');
    chip.querySelector('span').textContent = name;
    const headline = id === 'all'
      ? (C.headlineCAll || 'Can’t pick just one? Fair.')
      : String(C.headlineC2 || 'Good pick. [colour] it is.').replace(/\[colou?r\]/gi, name);
    root.querySelector('.ppp-c__title2').textContent = headline;
    track('popup_colour', { popup_colour: id });
    stepTo('form');
  }

  async function copyCode(btn) {
    const label = btn.querySelector('[data-copy-label]');
    try {
      await navigator.clipboard.writeText(btn.dataset.copy);
      label.textContent = 'Copied';
    } catch (e) {
      const range = document.createRange();
      range.selectNodeContents(btn.querySelector('b'));
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
      label.textContent = 'Selected';
    }
  }

  function tagsFor() {
    const tags = ['newsletter', 'popup', 'popup-' + variant, experiment];
    if (colour) tags.push('colour-' + colour);
    String(C.extraTags || '').split(',').map((t) => t.trim()).filter(Boolean).forEach((t) => tags.push(t));
    return tags.join(',');
  }

  async function send(email, tags) {
    if (C.preview) {
      await new Promise((r) => setTimeout(r, 650));
      return 'ok';
    }
    const fd = new FormData();
    fd.append('form_type', 'customer');
    fd.append('utf8', '✓');
    fd.append('contact[email]', email);
    fd.append('contact[tags]', tags);
    try {
      const res = await fetch(C.contactUrl || '/contact', {
        method: 'POST', body: fd, credentials: 'same-origin', headers: { Accept: 'text/html' },
      });
      // Shopify sometimes asks for a captcha; that needs a real page load.
      if (/\/challenge/.test(res.url)) return 'native';
      return res.ok ? 'ok' : 'error';
    } catch (e) {
      return 'native';
    }
  }

  // Fallback: post the hidden Shopify form the normal way. The page reloads
  // with ?customer_posted=true and boot() shows the success state.
  function nativeSubmit(email, tags) {
    const f = document.getElementById('pp-popup-native');
    if (!f) return false;
    f.querySelector('[name="contact[email]"]').value = email;
    f.querySelector('[name="contact[tags]"]').value = tags;
    store.set(K.pending, JSON.stringify({ v: variant, c: colour || 'none' }));
    f.submit();
    return true;
  }

  async function onSubmit(e) {
    e.preventDefault();
    const form = e.currentTarget;
    const input = form.querySelector('.ppp__input');
    const btn = form.querySelector('.ppp__btn');
    const err = form.querySelector('.ppp__err');
    const email = input.value.trim();
    err.hidden = true;
    input.removeAttribute('aria-invalid');

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      err.textContent = C.errEmail || 'That email doesn’t look right. Check it and try again.';
      err.hidden = false;
      input.setAttribute('aria-invalid', 'true');
      input.focus();
      return;
    }

    const label = btn.textContent;
    btn.disabled = true;
    btn.textContent = C.busyLabel || 'Joining…';
    const tags = tagsFor();
    const result = await send(email, tags);

    if (result === 'ok') {
      if (persist) store.set(K.joined, '1');
      track('popup_signup', { popup_colour: colour || 'none' });
      showDone();
    } else if (result === 'native' && nativeSubmit(email, tags)) {
      // page is navigating away
    } else {
      btn.disabled = false;
      btn.textContent = label;
      err.textContent = C.errNetwork || 'Couldn’t sign you up just now. Try again in a moment.';
      err.hidden = false;
    }
  }

  function onKey(e) {
    if (!root) return;
    if (e.key === 'Escape') { close('escape'); return; }
    if (e.key !== 'Tab' || !MODAL[variant]) return;
    const items = [...root.querySelectorAll('button, a[href], input')].filter((n) => !n.disabled && n.offsetParent);
    if (!items.length) return;
    const first = items[0];
    const last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  }

  function listen(target, type, fn, opts) {
    target.addEventListener(type, fn, opts);
    cleanups.push(() => target.removeEventListener(type, fn, opts));
  }

  /* ---------- when to show ---------- */

  function arm(v) {
    let fired = false;
    const timers = [];
    const fire = (trigger) => {
      if (fired || root) return;
      fired = true;
      timers.forEach(clearTimeout);
      open(v, { trigger });
    };

    const delay = Number(C.delay) || 0;
    if (delay > 0) timers.push(setTimeout(() => fire('delay'), delay * 1000));

    const scrollPct = Number(C.scroll) || 0;
    if (scrollPct > 0) {
      listen(window, 'scroll', () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        if (max > 0 && (window.scrollY / max) * 100 >= scrollPct) fire('scroll');
      }, { passive: true });
    }

    if (C.exitIntent && window.matchMedia('(pointer: fine)').matches) {
      // Wait a few seconds so a quick mouse flick on arrival doesn't count.
      timers.push(setTimeout(() => {
        listen(document, 'mouseout', (e) => {
          if (!e.relatedTarget && e.clientY <= 0) fire('exit');
        });
      }, 4000));
    }
    cleanups.push(() => timers.forEach(clearTimeout));
  }

  function boot() {
    listen(document, 'keydown', onKey);
    listen(window, 'resize', fit);
    if (mount !== document.body && 'ResizeObserver' in window) {
      const ro = new ResizeObserver(fit);
      ro.observe(mount);
      cleanups.push(() => ro.disconnect());
    }

    window.PocketPopup = {
      open: (v, opts) => open(String(v).toUpperCase(), opts || { trigger: 'manual' }),
      hideTab,
      close: () => close('api'),
      variant: () => variant,
      assign,
      config: C,
      reset() { Object.values(K).forEach(store.del); },
      destroy() {
        cleanups.splice(0).forEach((fn) => fn());
        if (root) { root.remove(); root = null; }
        hideTab();
        document.documentElement.classList.remove('ppp-lock');
      },
    };

    if (C.preview || C.enabled === false) return;

    if (C.designMode) {
      open(C.editorVariant || 'A', { silent: true });
      return;
    }

    // Back from the fallback form post: show the thank-you in the same design.
    const pending = store.get(K.pending);
    if (pending && /[?&]customer_posted=true/.test(location.search)) {
      store.del(K.pending);
      store.set(K.joined, '1');
      let p = {};
      try { p = JSON.parse(pending); } catch (e) { /* ignore */ }
      if (TEMPLATES[p.v]) {
        open(p.v, { silent: true, success: true });
        track('popup_signup', { popup_colour: p.c || 'none' });
      }
      return;
    }

    const forced = forcedVariant();
    if (forced) { open(forced, { trigger: 'url' }); return; }
    if (C.suppress || store.get(K.joined)) return;
    const v = assign();
    if (!v) return;
    const now = Date.now();
    if (Number(store.get(K.closedUntil) || 0) > now) {
      // Closed recently: no popup, just the tab (unless they hid that too).
      if (Number(store.get(K.tabOff) || 0) <= now) showTab(v);
      return;
    }
    arm(v);
  }

  boot();
})();
{% endraw %}</script>
{%- endif -%}

{% schema %}
{
  "name": "Newsletter popup",
  "class": "pp-popup-section",
  "settings": [
    { "type": "header", "content": "Turn on and A/B test" },
    { "type": "checkbox", "id": "enabled", "label": "Show the popup", "default": true },
    {
      "type": "text", "id": "experiment", "label": "Test name", "default": "popup-test-1",
      "info": "Change this name to start a brand-new test. Every visitor is shuffled into a design again."
    },
    { "type": "range", "id": "weight_a", "label": "Design A · Pocket Pop (share of visitors)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 34 },
    { "type": "range", "id": "weight_b", "label": "Design B · Lights On (share of visitors)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 33 },
    { "type": "range", "id": "weight_c", "label": "Design C · Colour Pick (share of visitors)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 33 },
