    },
    {
      "type": "range",
      "id": "weight_a",
      "label": "Design A · Pocket Pop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 20,
      "info": "Share of visitors who see this design."
    },
    {
      "type": "range",
      "id": "weight_b",
      "label": "Design B · Lights On",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "weight_c",
      "label": "Design C · Colour Pick",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "weight_d",
      "label": "Design D · Room Match",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "weight_e",
      "label": "Design E · Print Job",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 20
    },
    {
      "type": "paragraph",
      "content": "Set a design to 0 to switch it off. When you have a winner, set the others to 0. While editing here, the design with the biggest share is shown."
    },
    {
      "type": "header",
      "content": "When it appears"
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Computers: show after",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 8,
      "info": "0 turns this off."
    },
    {
      "type": "range",
      "id": "scroll",
      "label": "Or after scrolling",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40,
      "info": "0 turns this off."
    },
    {
      "type": "checkbox",
      "id": "exit_intent",
      "label": "Computers: show on exit",
      "default": true,
      "info": "When the mouse heads for the browser tabs."
    },
    {
      "type": "range",
      "id": "mobile_delay",
      "label": "Phones: show after",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 12,
      "info": "0 turns this off. A little longer than on computers, so visitors from Google see the page first."
    },
    {
      "type": "checkbox",
      "id": "mobile_exit",
      "label": "Phones: show on quick scroll up",
      "default": true,
      "info": "When someone flicks back up the page, like they are about to leave."
    },
    {
      "type": "range",
      "id": "hide_days",
      "label": "After closing, hide for",
      "min": 1,
      "max": 60,
      "step": 1,
      "unit": "d",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "tab",
